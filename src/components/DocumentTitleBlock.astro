---
// Shared title block for the Document/Index archetype pages (About,
// Privacy, Ecosystem, Compete, Proofmode, Explore): a functional h1 at
// Participate's scale, a lead at reading measure, no grid-bg, no
// right-hand card. Mono eyebrow only when it states a fact — omit the
// `eyebrow` prop rather than inventing one (Delta 15).
interface Props {
  eyebrow?: string;
}

const { eyebrow } = Astro.props;
---

<section class="doc-title-block">
  {eyebrow && <p class="mono doc-eyebrow">{eyebrow}</p>}
  <h1 class="doc-h1"><slot name="title" /></h1>
  <div class="doc-lead"><slot name="lead" /></div>
</section>

<style>
  .doc-title-block {
    padding: 62px 48px 48px;
    border-bottom: 1px solid var(--border);
  }

  .doc-eyebrow {
    color: var(--accent);
    margin: 0 0 20px;
  }

  .doc-h1 {
    font-size: clamp(2.5rem, 1.9rem + 3vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0 0 20px;
    max-width: 24ch;
  }

  .doc-lead {
    font-size: clamp(1.125rem, 1.038rem + 0.4348vw, 1.375rem);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 68ch;
  }

  .doc-lead :global(p) {
    margin: 0;
  }

  .doc-lead :global(p + p) {
    margin-top: 0.75em;
  }

  @media (max-width: 900px) {
    .doc-title-block {
      padding: 30px 18px 26px;
    }

    .doc-h1 {
      font-size: clamp(2.25rem, 1.95rem + 1.6vw, 2.875rem);
    }

    .doc-lead {
      font-size: 1.0625rem;
    }
  }
</style>
