---
import { siteConfig } from '../lib/site-config';

// Continuous marquee: a duplicated track scrolls
// seamlessly; `prefers-reduced-motion` freezes it. Logos are static files in
// /public/logos, shown on light tiles because most are dark-on-transparent.
---

<section class="partners" aria-label="Partners">
  <p class="mono label">Presented in collaboration with</p>
  <div class="marquee">
    <div class="marquee-track">
      <ul class="marquee-set">
        {siteConfig.partners.map((partner) => (
          <li>
            <a href={partner.url} target="_blank" rel="noopener noreferrer" title={partner.name} aria-label={`${partner.name} (opens in a new tab, external site)`}>
              <img src={partner.logo} alt={partner.name} decoding="async" />
            </a>
          </li>
        ))}
      </ul>
      <ul class="marquee-set" aria-hidden="true">
        {siteConfig.partners.map((partner) => (
          <li>
            <a href={partner.url} target="_blank" rel="noopener noreferrer" title={partner.name} aria-label={`${partner.name} (opens in a new tab, external site)`} tabindex="-1">
              <img src={partner.logo} alt="" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .partners {
    padding: 30px 0 34px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .label {
    margin: 0 0 18px;
    padding: 0 48px;
    color: var(--text-4);
  }

  .marquee {
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .marquee-set {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .marquee-set li {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
  }

  .marquee-set a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96px;
    padding: 14px 22px;
    border-radius: 8px;
    background: #fff;
    opacity: 0.88;
    transition: opacity 0.15s ease;
  }

  .marquee-set a:hover,
  .marquee-set a:focus-visible {
    opacity: 1;
  }

  .marquee-set img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 320px;
    object-fit: contain;
  }

  .marquee-set li::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--border-2);
  }

  @media (max-width: 900px) {
    .label {
      padding: 0 18px;
    }

    .marquee-set li {
      gap: 24px;
      padding-right: 24px;
    }

    .marquee-set a {
      height: 76px;
      padding: 10px 16px;
    }
  }
</style>
