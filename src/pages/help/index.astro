---
import { getCollection } from 'astro:content';
import Callout from '../../components/Callout.astro';
import Provisional from '../../components/Provisional.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { splitProvisional } from '../../lib/provisional';
import { siteConfig } from '../../lib/site-config';

const checks = [
  {
    title: "I don't see the option to submit a Location Attestation",
    description: 'In Location settings, confirm that the "Location Protocol attestations" option is enabled and that the wallet settings are configured.',
  },
  {
    title: 'Uploads to Filebase are failing',
    description: 'Test the Filebase connection in the Auto Sync settings.',
  },
  {
    title: 'Location attestations don\'t appear to be recorded on-chain',
    description: 'In the Wallet Settings screen, confirm that "Network" is set to an event supported network.',
  },
  {
    title: "Shouldn't my photos be automatically uploaded after capture?",
    description: 'Confirm that the "automatic uploads" and "include media" options are enabled in the Auto Sync settings.',
  },
  {
    title: "Shouldn't my photos be automatically attested to after capture?",
    description: 'Confirm that the "Auto-attest on capture" is set to On-chain in the Location settings.',
  },
  {
    title: 'The photo I captured is not showing up in the Submission map',
    description: 'From the capture gallery in Proofmode, check if the photo has the upload and attestation badge. If not, try manually uploading and attesting.',
  },
];

const supportRequestItems = [
  'Approximate Capture date and time',
  'Garden name',
  'Submission status',
  'Wallet address or Attestation identifier, if needed',
  'A description of the failed step',
];

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const entries = [...(await getCollection('faq'))].sort((a, b) => a.data.order - b.data.order);

const groups = Object.values(
  entries.reduce<Record<string, { category: string; slug: string; items: typeof entries }>>((acc, entry) => {
    const { category } = entry.data;
    acc[category] ??= { category, slug: slugify(category), items: [] };
    acc[category].items.push(entry);
    return acc;
  }, {}),
);

const totalQuestions = entries.length;
---

<BaseLayout
  title={`Help — ${siteConfig.eventTitle}`}
  description="Self-service Proofmode troubleshooting, what to include in a support request, the official support and takedown contact, and common event questions."
>
  <main id="main" data-help>
    <div class="hero-wrap grid-bg">
      <div class="hero-content">
        <p class="mono hero-eyebrow">Support &middot; FAQ</p>
        <h1 class="hero-title">Help</h1>
        <p class="hero-lead">
          Self-service support for common issues and answers to frequently asked questions.
        </p>
        <div class="hero-cta-row">
          <a class="hero-cta mono" href="#app-check">
            Quick Help
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4"></path>
            </svg>
          </a>
          <a class="hero-cta-ghost mono" href="#faq">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 4v14M6 13l6 6 6-6"></path>
            </svg>
            Skip to the FAQ
          </a>
        </div>
      </div>

      <div class="hero-contact" id="official-contact">
        <div class="spec">
          <div class="spec-head">
            <span class="mono" style="color: var(--text-3)">Official contact</span>
            <span class="mono chip-provisional">
              <span class="chip-dot" aria-hidden="true"></span>Provisional
            </span>
          </div>
          <div class="spec-contact">
            <p class="data spec-contact-value">
              {
                siteConfig.supportEmail ? (
                  siteConfig.supportEmail
                ) : (
                  <Provisional>support contact not yet published</Provisional>
                )
              }
            </p>
          </div>
          <div class="spec-body">
            <p>
              Any questions, concerns, or requests for assistance? Feel free to reach out and we'll get back to you as soon as possible.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Self-service checks -->
    <section id="app-check" class="wrap-section">
      <div class="section-head">
        <div>
          <p class="mono section-eyebrow">Quick Help</p>
          <h2 class="section-title">Proofmode Support</h2>
          <p class="section-lead">
            The following are common issues due to invalid configurations. Confirm that each of these Proofmode settings is properly configured.
            If you're still have issues, reach out for support.  
          </p>
        </div>
        <a class="mono section-link" href="/proofmode/">Full Proofmode setup →</a>
      </div>
      <div class="index-rows">
        {
          checks.map((check, i) => (
            <div class="idx-row">
              <span class="mono idx-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="idx-body">
                <h3 class="idx-title">{check.title}</h3>
                <p class="idx-summary">{check.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="notice-slot">
    </div>

    <!-- What to send / privacy route -->
    <section class="wrap-section two-col">
      <div>
        <h2 class="section-title">Need more support?</h2>
        <p class="section-lead">Feel free to reach out for additional assistance. If you have questions about a submission, please 
          include the following information:</p>
        <div class="points">
          {
            supportRequestItems.map((item) => (
              <div class="point">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 12.5l5 5L20 6.5" />
                </svg>
                <span>{item}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h2 class="section-title">Media or privacy concern</h2>
        <p class="section-lead">
          If a Submission contains inappropriate content, personal information, or another privacy concern, use the
          official contact above rather than reporting it in public.
        </p>
        <p class="section-lead">
          The organizer can unpin the media and blacklist the Attestation from the Public submission map. The
          on-chain Attestation remains, and copies held by other IPFS nodes may remain reachable.
        </p>
        <a class="mono section-link" href="/privacy/">What removal actually achieves →</a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="wrap-section faq-section">
      <div class="section-head">
        <div>
          <p class="mono section-eyebrow">Frequently asked</p>
          <h2 class="section-title">Questions and answers</h2>
        </div>
        <span class="mono section-meta">{totalQuestions} across {groups.length} topics</span>
      </div>

      <div class="jump-chips">
        {
          groups.map((group) => (
            <a class="chip mono" href={`#${group.slug}`}>
              {group.category} <span>{group.items.length}</span>
            </a>
          ))
        }
      </div>

      {
        groups.map((group) => (
          <div class="grp" id={group.slug}>
            <div class="grp-label">
              <p class="mono" style="color: var(--accent); margin: 0 0 8px">{group.category}</p>
              <span class="mono" style="color: var(--text-4)">{group.items.length} questions</span>
            </div>
            <div class="faq">
              {group.items.map((item) => (
                <details class="q">
                  <summary>
                    <span>{item.data.question}</span>
                    <span class="mk" aria-hidden="true" />
                  </summary>
                  <p class="a">
                    {splitProvisional(item.data.answer).map((seg) =>
                      seg.provisional ? <Provisional>{seg.text}</Provisional> : seg.text,
                    )}
                  </p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  main#main[data-help] {
    max-width: 1760px;
    padding: 0;
  }

  /* ---------- Hero ---------- */
  .hero-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 560px;
    gap: 0;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }

  .hero-content {
    padding: 72px 48px 68px;
  }

  .hero-eyebrow {
    color: var(--accent);
    margin: 0 0 22px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 1.9rem + 3vw, 3.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
  }

  .hero-lead {
    font-size: clamp(1.125rem, 1.038rem + 0.4348vw, 1.375rem);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 54ch;
    margin: 0 0 34px;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    background: var(--accent-solid);
    color: var(--accent-on);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    color: var(--accent-on);
    opacity: 0.88;
  }

  .hero-cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 15px 22px;
    border: 1px solid var(--border-2);
    color: var(--text-3);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }

  .hero-cta-ghost:hover,
  .hero-cta-ghost:focus-visible {
    color: var(--accent);
  }

  .hero-contact {
    align-self: stretch;
    padding: 72px 48px 68px;
    border-left: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    align-items: center;
  }

  /* ---------- Contact spec card ---------- */
  .spec {
    width: 100%;
    max-width: 400px;
    border: 1px solid var(--border-2);
    background: var(--bg);
  }

  .spec-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-2);
  }

  .chip-provisional {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    background: var(--warn-soft);
    color: var(--warn);
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: currentColor;
  }

  .spec-contact {
    padding: 20px 16px 18px;
    border-bottom: 1px solid var(--rule);
  }

  .spec-contact-value {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--text);
  }

  .spec-body {
    padding: 16px;
  }

  .spec-body p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-3);
  }

  .spec-foot {
    padding: 12px 16px;
    border-top: 1px solid var(--border-2);
    background: var(--accent-soft);
  }

  .spec-foot p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-3);
  }

  /* ---------- Section scaffolding ---------- */
  .wrap-section {
    padding: 64px 48px 68px;
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }

  .section-eyebrow {
    color: var(--accent);
    margin: 0 0 12px;
  }

  .section-title {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.06;
    margin: 0 0 14px;
  }

  .section-lead {
    margin: 0 0 16px;
    color: var(--text-2);
    max-width: 74ch;
    line-height: 1.6;
    font-size: 1.0625rem;
  }

  .section-link {
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .section-meta {
    color: var(--text-4);
    flex-shrink: 0;
  }

  /* ---------- Index rows (checks) ---------- */
  .index-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-2);
    margin-top: 26px;
  }

  .idx-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 32px;
    align-items: baseline;
    padding: 30px 0;
    border-bottom: 1px solid var(--rule);
  }

  .idx-row:last-child {
    border-bottom: 0;
  }

  .idx-num {
    color: var(--text-4);
  }

  .idx-body {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 32px;
    align-items: baseline;
  }

  .idx-title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .idx-summary {
    margin: 0;
    color: var(--text-2);
    max-width: 74ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  /* ---------- Notice slot ---------- */
  .notice-slot :global(.notice) {
    padding-inline: 48px;
  }

  /* ---------- Two-column support block ---------- */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .points {
    display: grid;
    gap: 14px;
  }

  .point {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 11px;
    align-items: start;
  }

  .point span {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  /* ---------- FAQ ---------- */
  .jump-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 34px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--border-2);
    color: var(--text-3);
    text-decoration: none;
  }

  .chip:hover,
  .chip:focus-visible {
    border-color: var(--accent-solid);
    color: var(--accent);
  }

  .chip span {
    color: var(--text-4);
  }

  .chip:hover span {
    color: var(--accent);
  }

  .grp {
    display: grid;
    grid-template-columns: 208px 1fr;
    gap: 40px;
    padding: 36px 0 30px;
    border-bottom: 1px solid var(--border);
  }

  .grp:last-child {
    border-bottom: 0;
  }

  .faq {
    border-top: 1px solid var(--rule);
  }

  .q {
    border-bottom: 1px solid var(--rule);
  }

  .q summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
  }

  .q summary::-webkit-details-marker {
    display: none;
  }

  .q summary:hover {
    color: var(--accent);
  }

  .q[open] summary {
    color: var(--accent);
  }

  .mk {
    flex: 0 0 auto;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-2);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1;
  }

  .mk::before {
    content: '+';
  }

  .q[open] .mk {
    border-color: var(--accent-solid);
    color: var(--accent);
  }

  .q[open] .mk::before {
    content: '\2212';
  }

  .q .a {
    margin: 0 0 20px;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 74ch;
  }

  @media (max-width: 900px) {
    .hero-wrap {
      display: block;
    }

    .hero-content {
      padding: 32px 18px 30px;
    }

    .hero-title {
      font-size: clamp(2.25rem, 1.95rem + 1.6vw, 2.875rem);
    }

    .hero-cta-row {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .hero-cta,
    .hero-cta-ghost {
      justify-content: center;
      min-height: 48px;
    }

    .hero-contact {
      padding: 28px 18px 30px;
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .spec {
      max-width: none;
    }

    .wrap-section {
      padding: 32px 18px 30px;
    }

    .notice-slot :global(.notice) {
      padding-inline: 18px;
    }

    .idx-row {
      grid-template-columns: 34px 1fr;
      padding: 18px 0;
    }

    .idx-body {
      display: block;
    }

    .idx-title {
      margin-bottom: 4px;
    }

    .two-col {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .grp {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }

    .grp-label {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
  }
</style>
