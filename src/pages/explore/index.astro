---
import DocumentTitleBlock from "../../components/DocumentTitleBlock.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import Provisional from "../../components/Provisional.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { splitProvisional } from "../../lib/provisional";
import { resolveGardenReferenceMapUrl, resolveSubmissionsMapUrl, siteConfig } from "../../lib/site-config";

const gardenReferenceMap = resolveGardenReferenceMapUrl();
const submissionsMap = resolveSubmissionsMapUrl();

const submissionAreasCopy =
  "Each Garden has a Submission area used to decide whether a Capture’s location qualifies. Submission areas are {{still being finalized and may combine overlapping areas}} into a single Submission area per Garden.";
---

<BaseLayout
  title={`Explore — ${siteConfig.eventTitle}`}
  description="Official UMD campus Gardens, what a Submission is, and a link to the Public submission map."
>
  <main id="main" data-document>
    <DocumentTitleBlock>
      <Fragment slot="title">Where will you explore next?</Fragment>
      <Fragment slot="lead">
        <p>
          Official Map for the {siteConfig.eventTitle} event. Use this map to explore where the official event Submissions Areas are
          and plan your garden crawl to compete.
        </p>
      </Fragment>
    </DocumentTitleBlock>

    <!-- Garden reference map: full width of the page frame, edge to
         hairline. Ignores the prose measure cap; does not break out to
         the viewport. The coming-soon placeholder uses the same slot. -->
    <div class="map-slot" data-map-slot>
      {
        gardenReferenceMap.available && gardenReferenceMap.url ? (
          <>
            <div class="map-toolbar">
              <span class="mono map-toolbar-label"> </span>
              <button type="button" class="map-expand" data-map-toggle aria-expanded="false">
                <svg class="icon-expand" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                </svg>
                <svg class="icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
                <span data-map-toggle-label>Expand map</span>
              </button>
            </div>
            <iframe class="garden-reference-map" src={gardenReferenceMap.url} title="Garden reference map" allowfullscreen />
          </>
        ) : (
          <div class="map-placeholder">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path d="M12 21s6.4-6.1 6.4-11A6.4 6.4 0 0 0 5.6 10c0 4.9 6.4 11 6.4 11z" />
              <circle cx="12" cy="10" r="2.4" />
            </svg>
            <p class="mono">Garden reference map — coming soon</p>
          </div>
        )
      }
    </div>

    <div class="doc-body">
      <section class="doc-section" aria-labelledby="event-submissions">
        <h2 id="event-submissions">How Submissions qualify</h2>
        <p>
          To ensure the photos you capture qualify for the event, a photo must be captured within an approved Garden Submission
          Area. Check out the map above to review each of the areas and get walking directions.
        </p>
      </section>

      <section class="doc-section" aria-labelledby="view-submissions">
        <h2 id="view-submissions">Every Submission is verifiable</h2>

        <p>
          Photos captured with Proofmode include signed location and capture-time information, creating a trusted record of what
          was captured, where it happened, and when.
        </p>
        <p>
          {
            submissionsMap.available && submissionsMap.url ? (
              <ExternalLink href={submissionsMap.url}>Open the Public submission map</ExternalLink>
            ) : (
              <span class="map-unavailable mono">Public submission map — coming soon</span>
            )
          }
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  // In-page "full screen": the map slot becomes a fixed overlay. The browser
  // Fullscreen API is unavailable for iframes on iPhone Safari, so this works
  // everywhere. Esc or the button collapses it again.
  const slot = document.querySelector<HTMLElement>("[data-map-slot]");
  const toggle = slot?.querySelector<HTMLButtonElement>("[data-map-toggle]");
  const label = slot?.querySelector<HTMLElement>("[data-map-toggle-label]");

  if (slot && toggle && label) {
    const setExpanded = (expanded: boolean) => {
      slot.classList.toggle("is-expanded", expanded);
      document.documentElement.style.overflow = expanded ? "hidden" : "";
      toggle.setAttribute("aria-expanded", String(expanded));
      label.textContent = expanded ? "Close map" : "Expand map";
      toggle.focus();
    };

    toggle.addEventListener("click", () => setExpanded(!slot.classList.contains("is-expanded")));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && slot.classList.contains("is-expanded")) setExpanded(false);
    });
  }
</script>

<style>
  main#main[data-document] {
    max-width: 1760px;
    padding: 0;
  }

  .map-slot {
    border-bottom: 1px solid var(--border);
  }

  .map-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px 8px 18px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .map-toolbar-label {
    color: var(--text-4);
  }

  .map-expand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--border-2);
    border-radius: 6px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .map-expand:hover,
  .map-expand:focus-visible {
    border-color: var(--accent-solid);
  }

  .icon-close,
  .is-expanded .icon-expand {
    display: none;
  }

  .is-expanded .icon-close {
    display: block;
  }

  .map-slot.is-expanded {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-bottom: 0;
  }

  .is-expanded .garden-reference-map {
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }

  .garden-reference-map {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 22rem;
    border: 0;
  }

  .map-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 22rem;
    background: var(--surface);
    color: var(--text-4);
  }

  .map-placeholder p {
    margin: 0;
  }

  .doc-body {
    padding: 64px 48px 84px;
  }

  .doc-section {
    margin-top: var(--space-lg, 2rem);
  }

  .doc-section:first-child {
    margin-top: 0;
  }

  h2 {
    max-width: 74ch;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-sm, 1rem);
    color: var(--text);
  }

  p {
    max-width: 74ch;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 var(--space-sm, 1rem);
  }

  p:last-child {
    margin-bottom: 0;
  }

  .map-unavailable {
    color: var(--text-4);
  }

  @media (max-width: 900px) {
    .garden-reference-map,
    .map-placeholder {
      min-height: 16rem;
    }

    .doc-body {
      padding: 32px 18px 56px;
    }
  }
</style>
